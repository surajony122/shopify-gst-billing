datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model StoreSetting {
  id                  String   @id @default(uuid())
  shop                String   @unique
  legalName           String?
  tradeName           String?
  gstin               String?
  panNumber           String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  stateCode           String?
  pincode             String?
  phone               String?
  email               String?
  
  // Invoicing Configurations
  invoicePrefix       String   @default("INV/{FY}/")
  nextInvoiceNumber   Int      @default(1)
  creditNotePrefix    String   @default("CN/{FY}/")
  nextCreditNoteNumber Int     @default(1)
  autoGenerateTrigger String   @default("on_fulfill") // "on_create" or "on_fulfill"
  roundOffSection170  Boolean  @default(true)
  autoEmailInvoice    Boolean  @default(true)
  
  // Customization & Branding
  invoiceTemplate     String   @default("standard_b2b") // "standard_b2b", "modern_d2c", "minimalist", "thermal_pos"
  brandColor          String   @default("#212B36")
  taxScheme           String   @default("regular") // "regular" (Rule 46) or "composition" (Rule 49 Bill of Supply)
  shippingGstRate     Float    @default(18.0)
  shippingTaxMode     String   @default("fixed_18") // "fixed_18", "exempt_0", "composite_highest"
  b2bStrictValidation Boolean  @default(true) // Enforce GSTIN state code match
  logoUrl             String?
  signatureUrl        String?
  termsAndConditions  String?  @default("Subject to local jurisdiction. Goods once sold cannot be taken back without valid reasons.")
  bankName            String?
  bankAccountNo       String?
  bankIfsc            String?
  upiId               String?

  // Editable Template Customizations
  invoiceTitle        String?  @default("TAX INVOICE")
  invoiceSubtitle     String?  @default("Original for Recipient | Rule 46 CGST Act")
  showLogo            Boolean  @default(true)
  showBankDetails     Boolean  @default(true)
  showUpiQr           Boolean  @default(true)
  showTerms           Boolean  @default(true)
  showHsnSummary      Boolean  @default(true)
  showSku             Boolean  @default(false)
  showSignature       Boolean  @default(true)
  signatureLabel      String?  @default("Authorized Signatory")
  footerNote          String?  @default("Thank you for shopping with us!")

  // B2B Routing & Series Rules
  b2bInvoicePrefix      String?  @default("B2B/{FY}/")
  nextB2BInvoiceNumber  Int      @default(1)
  b2bForceTemplate      Boolean  @default(true)
  b2bForcedTemplate     String   @default("standard_b2b")

  // Amount-based Routing Rules
  amountRulesEnabled       Boolean @default(false)
  highValueThreshold       Float   @default(10000.0)
  highValueTemplate        String  @default("standard_b2b")
  lowValueThreshold        Float   @default(1000.0)
  lowValueTemplate         String  @default("modern_d2c")
  ewayBillNoticeThreshold  Float   @default(50000.0)

  // HSN & Tiered Tax Rules
  apparelFootwearTierRule  Boolean @default(true) // <= 1000 -> 5%, > 1000 -> 12%
  hsnLengthRequired        Int     @default(6)

  // Integrations & Compliance
  einvoiceEnabled     Boolean  @default(false)
  einvoiceApiKey      String?
  whatsappEnabled     Boolean  @default(false)
  whatsappApiKey      String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WarehouseGSTIN {
  id            String   @id @default(uuid())
  shop          String
  locationId    String   // Shopify Location ID
  warehouseName String
  gstin         String
  state         String
  stateCode     String
  address       String
  invoicePrefix String?
  currentSequence Int    @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, locationId])
}

model Invoice {
  id                   String            @id @default(uuid())
  shop                 String
  shopifyOrderId       String            @unique
  shopifyOrderNumber   String
  invoiceNumber        String
  financialYear        String            // e.g. "2026-27"
  orderDate            DateTime
  invoiceDate          DateTime          @default(now())
  
  // Customer & Place of Supply
  isB2B                Boolean           @default(false)
  buyerGstin           String?
  buyerTradeName       String?
  buyerEmail           String?
  buyerPhone           String?
  shippingAddress      Json?
  billingAddress       Json?
  placeOfSupplyState   String
  placeOfSupplyCode    String
  isInterState         Boolean           // True: IGST, False: CGST + SGST

  // Financials
  subtotalTaxable      Float
  cgstTotal            Float             @default(0)
  sgstTotal            Float             @default(0)
  igstTotal            Float             @default(0)
  cessTotal            Float             @default(0)
  roundOffAmount       Float             @default(0)
  grandTotal           Float
  currency             String            @default("INR")

  // e-Invoice (IRN)
  irn                  String?
  irnQrCode            String?
  irnStatus            String?           // "NOT_APPLICABLE", "GENERATED", "FAILED"
  irnAckNo             String?

  // Delivery Status
  templateUsed         String            @default("standard_b2b")
  ewayBillRequired     Boolean           @default(false)
  emailSent            Boolean           @default(false)
  whatsappSent         Boolean           @default(false)
  pdfPath              String?

  lineItems            InvoiceLineItem[]
  creditNotes          CreditNote[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([shop, invoiceNumber])
  @@index([shop, invoiceDate])
}

model InvoiceLineItem {
  id                 String   @id @default(uuid())
  invoiceId          String
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shopifyLineItemId  String?
  title              String
  variantTitle       String?
  sku                String?
  hsnCode            String   @default("999999")
  quantity           Int
  unitPrice          Float
  discountAmount     Float    @default(0)
  taxableValue       Float
  gstRate            Float    // Total GST rate percentage (e.g. 18.0)
  cgstRate           Float    @default(0)
  cgstAmount         Float    @default(0)
  sgstRate           Float    @default(0)
  sgstAmount         Float    @default(0)
  igstRate           Float    @default(0)
  igstAmount         Float    @default(0)
  totalAmount        Float
}

model CreditNote {
  id                   String   @id @default(uuid())
  shop                 String
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shopifyRefundId      String   @unique
  creditNoteNumber     String
  financialYear        String
  reason               String?
  date                 DateTime @default(now())
  taxableAdjusted      Float
  cgstAdjusted         Float    @default(0)
  sgstAdjusted         Float    @default(0)
  igstAdjusted         Float    @default(0)
  grandTotalAdjusted   Float
  pdfPath              String?
  createdAt            DateTime @default(now())
}

model HsnCatalog {
  id                String   @id @default(uuid())
  shop              String
  shopifyProductId  String
  shopifyVariantId  String?
  productTitle      String
  variantTitle      String?
  sku               String?
  hsnCode           String
  gstRate           Float    @default(18.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, shopifyProductId, shopifyVariantId])
  @@index([shop, hsnCode])
}

model CollectionHsn {
  id                  String   @id @default(uuid())
  shop                String
  shopifyCollectionId String
  collectionTitle     String
  hsnCode             String
  gstRate             Float    @default(18.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shop, shopifyCollectionId])
  @@index([shop, shopifyCollectionId])
}
