{
  "name": "shopify-gst-billing",
  "private": true,
  "version": "1.0.0",
  "description": "GST Invoicing, e-Invoicing (IRN), e-Way Bill & GSTR-1 Filing App for Shopify India",
  "sideEffects": false,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@remix-run/dev": "^2.12.1",
    "@remix-run/node": "^2.12.1",
    "@remix-run/react": "^2.12.1",
    "@remix-run/serve": "^2.12.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.1",
    "@shopify/polaris-icons": "^9.3.0",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-remix": "^6.0.2",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "isbot": "^5.1.17",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.3",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-tsconfig-paths": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
